# Python environment for the demo agent workers and DataHub emitter
agents/.venv/

# Separate environment for DataHub's Agent Context Kit. Apart from the one above
# because the kit pins acryl-datahub to a different patch release than the one
# agents/graph.py's writes are verified against. See docs/environment-findings.md
# section 15.
agents/.venv-context/
**/__pycache__/
*.pyc

# Local run output (runs are reproducible; artifacts are not committed)
.obsel/

# Browser-automation scratch from checking the page by hand
.playwright-mcp/
/*.png

# Tool-local launch config (created by the editor's browser preview)
.claude/

# Vendored agent skills (Remotion's, for the demo video). `skills-lock.json` IS
# committed, so the set is reproducible with `npx skills add`; the copies are
# third-party markdown and stay out of the judge-facing repo, the same way
# `.claude/` does.
.agents/

# Internal dev docs, kept local but out of the judge-facing repo
CLAUDE.md
CLAUDE.local.md
hackathon.md
docs/demo-script.md

# Recorded takes and picture locks: same-run evidence for the video, never committed.
# The reference take lives here so a reboot cannot eat it; the submission video
# is cut by the owner from a take like these.
out/

# The staged video assets: large, licensed for use in a video rather than
# for redistribution, and a property of whoever is rendering.
.video-public

# The submission video's whole production line, kept out of the repository by
# the owner's decision: the deliverable is a YouTube video, not source in the
# tree. The composition, the recording and staging scripts, and the tests that
# check the cut all stay local.
video/

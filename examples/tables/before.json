  "pipeline_docs": {
    "columns": ["section", "heading", "text"],
    "rows": [
      {
        "heading": "order_date",
        "section": "column",
        "text": "The calendar date used to group orders, formatted as YYYY-MM-DD. Its unit is one calendar day. It was derived from each source order's date, with all represented orders sharing the same date collapsed into one daily row."
      },
      {
        "heading": "total_revenue",
        "section": "column",
        "text": "The combined revenue of the represented orders for order_date. Its unit is currency, stored to two decimal places in the observed rows; the currency itself is not identified by this table. It was derived by summing the revenue amounts of all represented orders in that date's group."
      },
      {
        "heading": "order_count",
        "section": "column",
        "text": "The number of represented orders for order_date. Its unit is orders. It was derived by counting the source orders in that date's group."
      },
      {
        "heading": "average_order_value",
        "section": "column",
        "text": "The mean revenue per represented order for order_date. Its unit is currency per order, using the same unidentified currency as total_revenue. It was derived as total_revenue divided by order_count and is not rounded to two decimal places in storage."
      },
      {
        "heading": "What the table deliberately excludes",
        "section": "exclusions",
        "text": "This is a daily aggregate, so it excludes order-level fields and detail such as order identifiers, timestamps within a day, customers, line items, and payment attributes. It also has no columns for tax, shipping, discounts, refunds, cancellations, order status, or currency, so those components and their treatment cannot be separated or determined from this table. Dates without a row are not represented; the table does not supply explicit zero-revenue days."
      }
    ]
  },

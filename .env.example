# DataHub connection (local open-source quickstart defaults)
# GMS is port 8080. Port 9002 is the frontend proxy, NOT GMS — do not point the client at it.
DATAHUB_GMS_URL=http://localhost:8080
DATAHUB_FRONTEND_URL=http://localhost:9002

# Optional against a default `datahub docker quickstart`.
# The quickstart sets METADATA_SERVICE_AUTH_ENABLED=false, which disables the UI's
# Settings -> Access Tokens page, so no PAT can be generated — and none is needed,
# because GMS then accepts unauthenticated requests. Set this only if you recreated
# the stack with auth enabled. See docs/environment-findings.md section 4.
DATAHUB_GMS_TOKEN=

# MCP server version. PINNED DELIBERATELY — do not change to @latest.
# `uvx mcp-server-datahub@latest` resolves to a read-only 0.4.0 that has no mutation
# tools and silently ignores TOOLS_IS_MUTATION_ENABLED, so obsel would be unable to
# mark anything stale while still reporting success.
# See docs/environment-findings.md section 2.
MCP_SERVER_DATAHUB_VERSION=0.6.0

# Enables the MCP server's 11 write tools. Read at process start during tool
# registration, so it must be set before the server is spawned.
TOOLS_IS_MUTATION_ENABLED=true
TOOLS_IS_USER_ENABLED=true

# Where obsel is listening. Read by the demo agent workers and by obsel's own MCP
# server (agents/mcp_server.py), NOT by the obsel server itself — this is how a
# client finds obsel, not how obsel binds. Leave it unset for the default.
OBSEL_URL=http://localhost:3000

# OBSEL_API_TOKEN gates every mutating route: tasks, demo, and erasure. Reads
# stay open. With no token those routes answer 503 rather than accepting
# anything — an unconfigured deployment is a closed one, not an open one.
# `scripts/start.sh` generates a value here when this line is empty, and the
# board's token field takes the same value for the browser's own writes.
#
# The erasure half additionally needs OBSEL_ATTESTOR_KEYS, and stays off
# without it: nothing verifies, so every asset stays UNPROVEN.
#
# OBSEL_API_TOKEN is not what makes an attestation trustworthy — the signature,
# the key registry and the challenge are. It stops an unauthenticated party
# opening requests and burning challenges. `GET /api/erasure/<id>` needs no
# token, because a coverage report is what the operator is trying to publish.
#
# OBSEL_ATTESTOR_KEYS is inline JSON or a path to a JSON file, read at startup.
# There is no route that registers a key, on purpose: an endpoint that adds keys
# is an endpoint that mints attestations. docs/setup.md has the shape and the
# openssl commands.
OBSEL_API_TOKEN=
OBSEL_ATTESTOR_KEYS=

# Which coding CLI runs the demo agents: codex, claude, or unset.
#
# Unset means whichever is installed, Codex first when both are. An explicit
# value is never second-guessed: if the CLI you named is missing, that is what
# the failure says, rather than quietly running the other one and reporting a
# product you did not choose. The board's checklist, scripts/start.sh and the
# workers all read this, so they cannot disagree about what did the work.
#
# Most measured figures in docs/verification.md were taken against Codex; the
# forty-task pipeline has also run end to end on Claude Code once.
OBSEL_RUNNER=

# Which DataFlow the page shows and the demo agents work on. Read once when the
# server starts; the agents read it independently, so set it the same way for
# both. Unset means the default page. Each flow keeps its own tasks — see
# "Which page obsel opens" in docs/setup.md.
OBSEL_FLOW_ID=orders_pipeline

# There is deliberately no model API key here.
#
# The demo agent workers in agents/ are real sessions of the CLI above and
# authenticate through it — `codex login status` or `claude auth status` is the
# check that matters. obsel's own coordinator makes no model calls at all: it is
# graph traversal, not inference, which is the point of the whole design.
